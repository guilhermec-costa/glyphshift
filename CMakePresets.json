{
  "version": 2,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "GLYPHSHIFT_LINK_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows Debug development build (MSVC, vcpkg; run from a Visual Studio developer shell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "CMAKE_CXX_COMPILER": "cl",
        "GLYPHSHIFT_LINK_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release build (MSVC, vcpkg; run from a Visual Studio developer shell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON", "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "windows-dev", "configurePreset": "windows-dev" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "windows-dev", "configurePreset": "windows-dev", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } }
  ]
}
