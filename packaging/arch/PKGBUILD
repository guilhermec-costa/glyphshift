# Maintainer: Guilherme China
pkgname=glyphshift
pkgver=0.1.0
pkgrel=1
pkgdesc='Live glyph and ASCII art for games on Linux/X11: a capture overlay with a global hotkey, and an injected OpenGL/Vulkan renderer'
arch=('x86_64')
url='https://github.com/guilhermec-costa/glyphshift'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libx11' 'libglvnd' 'vulkan-icd-loader' 'freetype2' 'fontconfig'
         'libxcb' 'xcb-util-keysyms' 'libxcomposite' 'libxdamage' 'libxfixes' 'libxft'
         'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'python' 'glslang' 'vulkan-headers')
optdepends=('ttf-dejavu: preferred monospace font for text glyph sets'
            'libnotify: desktop notifications when started from the menu'
            'dex: XDG autostart under i3 and other minimal window managers')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  # CPU, configuration, launcher and install tests; graphics tests need a display.
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
